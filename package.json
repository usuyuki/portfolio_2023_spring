{
	"name": "portfolio-2023-spring",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"1": "pnpm format && (pnpm lint & pnpm check) && exit 0",
		"tests": "pnpm test:u & pnpm test:i",
		"dev": "vite dev",
		"dev-cf": "wrangler dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"test:u": "vitest run --config vitest.config.ts",
		"test:i": "playwright test -c playwright.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/gtag.js": "^0.0.20",
		"@types/tryghost__content-api": "^1.3.17",
		"autoprefixer": "^10.6.1",
		"jsdom": "^30.1.0",
		"postcss": "^8.5.28",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.135.0"
	},
	"type": "module",
	"dependencies": {
		"@notionhq/client": "^5.26.0",
		"@tryghost/content-api": "^1.12.11",
		"embla-carousel": "^8.6.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"gsap": "^3.15.0"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.0.0"
	}
}
