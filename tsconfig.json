{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "node", "vitest/globals"]
	},
	// worker-configuration.d.ts は `pnpm wrangler types` で生成する cloudflare:workers と env.KV の型定義
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts",
		"tests",
		"worker-configuration.d.ts"
	]
}
